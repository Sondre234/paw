 struct wlr_gles2_tex_shader {
 	GLuint program;
 	GLint proj;
@@ -35,6 +43,7 @@ struct wlr_gles2_tex_shader {
 	GLint tex;
 	GLint alpha;
 	GLint pos_attrib;
+	struct wlr_gles2_rounding_uniforms rounding;
 };
 
 struct wlr_gles2_renderer {
@@ -79,6 +88,7 @@ struct wlr_gles2_renderer {
 			GLint proj;
 			GLint color;
 			GLint pos_attrib;
+			struct wlr_gles2_rounding_uniforms rounding;
 		} quad;
 		struct wlr_gles2_tex_shader tex_rgba;
 		struct wlr_gles2_tex_shader tex_rgbx;

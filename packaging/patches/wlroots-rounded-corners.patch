index 89f6de9..ebb107a 100644
--- a/include/wlr/render/interface.h
+++ b/include/wlr/render/interface.h
@@ -15,6 +15,7 @@
 #include <wlr/render/wlr_texture.h>
 #include <wlr/types/wlr_output.h>
 #include <wlr/render/dmabuf.h>

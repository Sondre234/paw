diff --git a/include/wlr/render/pass.h b/include/wlr/render/pass.h
index 61ab771..3f86a32 100644
--- a/include/wlr/render/pass.h
+++ b/include/wlr/render/pass.h
@@ -157,4 +157,28 @@ struct wlr_render_rect_options {
 void wlr_render_pass_add_rect(struct wlr_render_pass *render_pass,
 	const struct wlr_render_rect_options *options);
 
+/**
+ * Rounded rectangles that shape what the render pass draws next, in buffer
+ * coordinates like the boxes of the render options.
+ *
+ * Only what lies inside the clip rectangle (with corners of radius
+ * clip_radius) is drawn, and nothing that lies inside the hole rectangle
+ * (corners of radius hole_radius). An empty box disables either part. The
+ * edges are anti-aliased.
+ */
+struct wlr_render_rounding {
+	struct wlr_box clip;
+	int clip_radius;
+	struct wlr_box hole;
+	int hole_radius;
+};
+
+/**
+ * Apply a rounding to the textures and rectangles added to the render pass
+ * from now on, or stop doing so with NULL. Renderers that do not support it
+ * ignore it.
+ */
+void wlr_render_pass_set_rounding(struct wlr_render_pass *render_pass,
+	const struct wlr_render_rounding *rounding);
+
 #endif
diff --git a/include/wlr/types/wlr_scene.h b/include/wlr/types/wlr_scene.h
index 6c627b1..107b110 100644
--- a/include/wlr/types/wlr_scene.h
+++ b/include/wlr/types/wlr_scene.h
@@ -469,6 +469,23 @@ void wlr_scene_rect_set_size(struct wlr_scene_rect *rect, int width, int height)
  */
 void wlr_scene_rect_set_color(struct wlr_scene_rect *rect, const float color[static 4]);
 
+/**
+ * Round the corners of the rectangle with the given radius. With a non-zero
+ * hole_width, only a frame of that width along its edges is drawn, rounded
+ * on the outside with radius and on the inside with radius - hole_width.
+ * Zero for both draws a plain rectangle again.
+ */
+void wlr_scene_rect_set_rounding(struct wlr_scene_rect *rect, int radius,
+	int hole_width);
+
+/**
+ * Clip everything below the tree to a rectangle with corners rounded with the
+ * given radius. The box is in the tree's coordinates. NULL removes the clip.
+ * Only the nearest clipped ancestor of a node applies to it.
+ */
+void wlr_scene_tree_set_rounded_clip(struct wlr_scene_tree *tree,
+	const struct wlr_box *box, int radius);
+
 /**
  * Add a node displaying a buffer to the scene-graph.
  *
diff --git a/render/gles2/pass.c b/render/gles2/pass.c
index a70ea13..20d3acc 100644
--- a/render/gles2/pass.c
+++ b/render/gles2/pass.c
@@ -153,6 +153,25 @@ static void set_tex_matrix(GLint loc, enum wl_output_transform trans,
 	glUniformMatrix3fv(loc, 1, GL_FALSE, tex_matrix);
 }
 
+// A box of the rounding and its corners' radius, negative for an empty box,
+// which the shaders then leave out
+static void set_rounded_box_uniforms(GLint box_loc, GLint radius_loc,
+		const struct wlr_box *box, int radius) {
+	glUniform4f(box_loc, box->x, box->y, box->width, box->height);
+	glUniform1f(radius_loc, wlr_box_empty(box) ? -1 : radius);
+}
+
+// The rounding of the pass, for a draw over box
+static void set_rounding_uniforms(const struct wlr_gles2_rounding_uniforms *uniforms,
+		const struct wlr_render_pass *pass, const struct wlr_box *box) {
+	glUniform4f(uniforms->pos_box, box->x, box->y, box->width, box->height);
+	const struct wlr_render_rounding *rounding = &pass->rounding;
+	set_rounded_box_uniforms(uniforms->clip_box, uniforms->clip_radius,
+		&rounding->clip, rounding->clip_radius);
+	set_rounded_box_uniforms(uniforms->hole_box, uniforms->hole_radius,
+		&rounding->hole, rounding->hole_radius);
+}
+
 static void setup_blending(enum wlr_render_blend_mode mode) {
 	switch (mode) {
 	case WLR_RENDER_BLEND_MODE_PREMULTIPLIED:
@@ -223,8 +242,10 @@ static void render_pass_add_texture(struct wlr_render_pass *wlr_pass,
 		}
 	}
 
-	setup_blending(!texture->has_alpha && alpha == 1.0 ?
-		WLR_RENDER_BLEND_MODE_NONE : options->blend_mode);
+	// Rounded corners leave parts of the texture transparent
+	setup_blending(wlr_pass->has_rounding ? WLR_RENDER_BLEND_MODE_PREMULTIPLIED :
+		!texture->has_alpha && alpha == 1.0 ? WLR_RENDER_BLEND_MODE_NONE :
+		options->blend_mode);
 
 	glUseProgram(shader->program);
 
@@ -246,6 +267,7 @@ static void render_pass_add_texture(struct wlr_render_pass *wlr_pass,
 	glUniform1f(shader->alpha, alpha);
 	set_proj_matrix(shader->proj, pass->projection_matrix, &dst_box);
 	set_tex_matrix(shader->tex_proj, options->transform, &src_fbox);
+	set_rounding_uniforms(&shader->rounding, wlr_pass, &dst_box);
 
 	render(&dst_box, options->clip, shader->pos_attrib);
 
@@ -265,6 +287,7 @@ static void render_pass_add_rect(struct wlr_render_pass *wlr_pass,
 
 	push_gles2_debug(renderer);
 	enum wlr_render_blend_mode blend_mode =
+		wlr_pass->has_rounding ? WLR_RENDER_BLEND_MODE_PREMULTIPLIED :
 		color->a == 1.0 ? WLR_RENDER_BLEND_MODE_NONE : options->blend_mode;
 	if (blend_mode == WLR_RENDER_BLEND_MODE_NONE &&
 			options->clip == NULL &&
@@ -278,6 +301,7 @@ static void render_pass_add_rect(struct wlr_render_pass *wlr_pass,
 		glUseProgram(renderer->shaders.quad.program);
 		set_proj_matrix(renderer->shaders.quad.proj, pass->projection_matrix, &box);
 		glUniform4f(renderer->shaders.quad.color, color->r, color->g, color->b, color->a);
+		set_rounding_uniforms(&renderer->shaders.quad.rounding, wlr_pass, &box);
 		render(&box, options->clip, renderer->shaders.quad.pos_attrib);
 	}
 
diff --git a/render/gles2/renderer.c b/render/gles2/renderer.c
index e362dae..962a7ce 100644
--- a/render/gles2/renderer.c
+++ b/render/gles2/renderer.c
@@ -425,6 +425,15 @@ static GLuint compile_shader(struct wlr_gles2_renderer *renderer,
 	return shader;
 }
 
+static void get_rounding_uniforms(GLuint prog,
+		struct wlr_gles2_rounding_uniforms *rounding) {
+	rounding->pos_box = glGetUniformLocation(prog, "pos_box");
+	rounding->clip_box = glGetUniformLocation(prog, "clip_box");
+	rounding->clip_radius = glGetUniformLocation(prog, "clip_radius");
+	rounding->hole_box = glGetUniformLocation(prog, "hole_box");
+	rounding->hole_radius = glGetUniformLocation(prog, "hole_radius");
+}
+
 static GLuint link_program(struct wlr_gles2_renderer *renderer,
 		const GLchar *vert_src, const GLchar *frag_src) {
 	push_gles2_debug(renderer);
@@ -641,6 +650,7 @@ struct wlr_renderer *wlr_gles2_renderer_create(struct wlr_egl *egl) {
 	renderer->shaders.quad.proj = glGetUniformLocation(prog, "proj");
 	renderer->shaders.quad.color = glGetUniformLocation(prog, "color");
 	renderer->shaders.quad.pos_attrib = glGetAttribLocation(prog, "pos");
+	get_rounding_uniforms(prog, &renderer->shaders.quad.rounding);
 
 	renderer->shaders.tex_rgba.program = prog =
 		link_program(renderer, common_vert_src, tex_rgba_frag_src);
@@ -652,6 +662,7 @@ struct wlr_renderer *wlr_gles2_renderer_create(struct wlr_egl *egl) {
 	renderer->shaders.tex_rgba.tex = glGetUniformLocation(prog, "tex");
 	renderer->shaders.tex_rgba.alpha = glGetUniformLocation(prog, "alpha");
 	renderer->shaders.tex_rgba.pos_attrib = glGetAttribLocation(prog, "pos");
+	get_rounding_uniforms(prog, &renderer->shaders.tex_rgba.rounding);
 
 	renderer->shaders.tex_rgbx.program = prog =
 		link_program(renderer, common_vert_src, tex_rgbx_frag_src);
@@ -663,6 +674,7 @@ struct wlr_renderer *wlr_gles2_renderer_create(struct wlr_egl *egl) {
 	renderer->shaders.tex_rgbx.tex = glGetUniformLocation(prog, "tex");
 	renderer->shaders.tex_rgbx.alpha = glGetUniformLocation(prog, "alpha");
 	renderer->shaders.tex_rgbx.pos_attrib = glGetAttribLocation(prog, "pos");
+	get_rounding_uniforms(prog, &renderer->shaders.tex_rgbx.rounding);
 
 	if (renderer->exts.OES_egl_image_external) {
 		renderer->shaders.tex_ext.program = prog =
@@ -675,6 +687,7 @@ struct wlr_renderer *wlr_gles2_renderer_create(struct wlr_egl *egl) {
 		renderer->shaders.tex_ext.tex = glGetUniformLocation(prog, "tex");
 		renderer->shaders.tex_ext.alpha = glGetUniformLocation(prog, "alpha");
 		renderer->shaders.tex_ext.pos_attrib = glGetAttribLocation(prog, "pos");
+		get_rounding_uniforms(prog, &renderer->shaders.tex_ext.rounding);
 	}
 
 	pop_gles2_debug(renderer);
diff --git a/render/gles2/shaders/common.vert b/render/gles2/shaders/common.vert
index f51548a..f2717ab 100644
--- a/render/gles2/shaders/common.vert
+++ b/render/gles2/shaders/common.vert
@@ -1,10 +1,27 @@
 uniform mat3 proj;
 uniform mat3 tex_proj;
+uniform vec4 pos_box;
+uniform vec4 clip_box;
+uniform vec4 hole_box;
 attribute vec2 pos;
 varying vec2 v_texcoord;
+varying vec4 v_clip;
+varying vec4 v_hole;
+
+// How far p lies inside the left, top, right and bottom edges of box
+vec4 insets(vec2 p, vec4 box) {
+	return vec4(p - box.xy, box.xy + box.zw - p);
+}
 
 void main() {
 	vec3 pos3 = vec3(pos, 1.0);
 	gl_Position = vec4(pos3 * proj, 1.0);
 	v_texcoord = (pos3 * tex_proj).xy;
+	// For the rounding: distances from the edges of its boxes, in buffer
+	// coordinates. Small where the rounding shapes anything, they keep their
+	// precision in a fragment shader at mediump (16-bit floats on NVIDIA, which
+	// leaves GL_FRAGMENT_PRECISION_HIGH undefined), as coordinates do not
+	vec2 p = pos_box.xy + pos * pos_box.zw;
+	v_clip = insets(p, clip_box);
+	v_hole = insets(p, hole_box);
 }
diff --git a/render/gles2/shaders/quad.frag b/render/gles2/shaders/quad.frag
index 97d3a31..da1e098 100644
--- a/render/gles2/shaders/quad.frag
+++ b/render/gles2/shaders/quad.frag
@@ -8,6 +8,33 @@ varying vec4 v_color;
 varying vec2 v_texcoord;
 uniform vec4 color;
 
+varying vec4 v_clip;
+varying vec4 v_hole;
+uniform float clip_radius;
+uniform float hole_radius;
+
+// Signed distance to a rectangle with rounded corners, negative inside, from
+// how far inside its left, top, right and bottom edges the fragment lies
+float rounded_box(vec4 insets, float radius) {
+	vec2 size = insets.xy + insets.zw;
+	radius = min(radius, 0.5 * min(size.x, size.y));
+	vec2 q = radius - min(insets.xy, insets.zw);
+	return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;
+}
+
+// How much of the fragment lies inside the clip and outside the hole; a
+// negative radius leaves either out
+float rounding() {
+	float coverage = 1.0;
+	if (clip_radius >= 0.0) {
+		coverage *= clamp(0.5 - rounded_box(v_clip, clip_radius), 0.0, 1.0);
+	}
+	if (hole_radius >= 0.0) {
+		coverage *= clamp(0.5 + rounded_box(v_hole, hole_radius), 0.0, 1.0);
+	}
+	return coverage;
+}
+
 void main() {
-	gl_FragColor = color;
+	gl_FragColor = color * rounding();
 }
diff --git a/render/gles2/shaders/tex_external.frag b/render/gles2/shaders/tex_external.frag
index 73909fe..17c3335 100644
--- a/render/gles2/shaders/tex_external.frag
+++ b/render/gles2/shaders/tex_external.frag
@@ -10,6 +10,33 @@ varying vec2 v_texcoord;
 uniform samplerExternalOES texture0;
 uniform float alpha;
 
+varying vec4 v_clip;
+varying vec4 v_hole;
+uniform float clip_radius;
+uniform float hole_radius;
+
+// Signed distance to a rectangle with rounded corners, negative inside, from
+// how far inside its left, top, right and bottom edges the fragment lies
+float rounded_box(vec4 insets, float radius) {
+	vec2 size = insets.xy + insets.zw;
+	radius = min(radius, 0.5 * min(size.x, size.y));
+	vec2 q = radius - min(insets.xy, insets.zw);
+	return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;
+}
+
+// How much of the fragment lies inside the clip and outside the hole; a
+// negative radius leaves either out
+float rounding() {
+	float coverage = 1.0;
+	if (clip_radius >= 0.0) {
+		coverage *= clamp(0.5 - rounded_box(v_clip, clip_radius), 0.0, 1.0);
+	}
+	if (hole_radius >= 0.0) {
+		coverage *= clamp(0.5 + rounded_box(v_hole, hole_radius), 0.0, 1.0);
+	}
+	return coverage;
+}
+
 void main() {
-	gl_FragColor = texture2D(texture0, v_texcoord) * alpha;
+	gl_FragColor = texture2D(texture0, v_texcoord) * alpha * rounding();
 }

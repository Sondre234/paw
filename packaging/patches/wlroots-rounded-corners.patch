 struct wlr_box;
 struct wlr_fbox;
@@ -50,6 +51,10 @@ void wlr_texture_init(struct wlr_texture *texture, struct wlr_renderer *rendener
 
 struct wlr_render_pass {
 	const struct wlr_render_pass_impl *impl;
+

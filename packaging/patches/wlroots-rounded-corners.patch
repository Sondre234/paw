diff --git a/render/pass.c b/render/pass.c
index 23bdf96..e20d333 100644
--- a/render/pass.c
+++ b/render/pass.c
@@ -10,6 +10,14 @@ void wlr_render_pass_init(struct wlr_render_pass *render_pass,
 	};
 }
 
+void wlr_render_pass_set_rounding(struct wlr_render_pass *render_pass,
+		const struct wlr_render_rounding *rounding) {
+	render_pass->has_rounding = rounding != NULL &&
+		(!wlr_box_empty(&rounding->clip) || !wlr_box_empty(&rounding->hole));
+	render_pass->rounding = render_pass->has_rounding ?
+		*rounding : (struct wlr_render_rounding){0};
+}
+
 bool wlr_render_pass_submit(struct wlr_render_pass *render_pass) {
 	return render_pass->impl->submit(render_pass);
 }
diff --git a/types/scene/wlr_scene.c b/types/scene/wlr_scene.c
index 7bc8b76..7139a42 100644
--- a/types/scene/wlr_scene.c
+++ b/types/scene/wlr_scene.c
@@ -256,7 +256,80 @@ static bool scene_nodes_in_box(struct wlr_scene_node *node, struct wlr_box *box,
 	return _scene_nodes_in_box(node, box, iterator, user_data, x, y);
 }
 
-static void scene_node_opaque_region(struct wlr_scene_node *node, int x, int y,
+struct scene_rounding {
+	struct wlr_addon addon;
+	// Trees: the clip in the tree's coordinates
+	struct wlr_box box;
+	int radius;
+	// Rects: the width of the frame they are reduced to, 0 for a full rect
+	int hole_width;
+};
+
+static void scene_rounding_destroy(struct wlr_addon *addon) {
+	struct scene_rounding *rounding = wl_container_of(addon, rounding, addon);
+	wlr_addon_finish(addon);
+	free(rounding);
+}
+
+static const struct wlr_addon_interface tree_clip_impl = {
+	.name = "wlr_scene_tree_rounded_clip",
+	.destroy = scene_rounding_destroy,
+};
+
+static const struct wlr_addon_interface rect_rounding_impl = {
+	.name = "wlr_scene_rect_rounding",
+	.destroy = scene_rounding_destroy,
+};
+
+static struct scene_rounding *scene_rounding_find(struct wlr_scene_node *node,
+		const struct wlr_addon_interface *impl) {
+	struct wlr_addon *addon = wlr_addon_find(&node->addons, node, impl);
+	if (addon == NULL) {
+		return NULL;
+	}
+	struct scene_rounding *rounding = wl_container_of(addon, rounding, addon);
+	return rounding;
+}
+
+static struct scene_rounding *scene_rounding_ensure(struct wlr_scene_node *node,
+		const struct wlr_addon_interface *impl) {
+	struct scene_rounding *rounding = scene_rounding_find(node, impl);
+	if (rounding != NULL) {
+		return rounding;
+	}

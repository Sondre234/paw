// tekketsu (鉄血) for fastfetch: the elf mage beside a spec sheet in a box, the hardware under
// `karakuri`, the mechanism. Crimson titles and icons, bone keys and an iron frame, set in 24-bit
// colour so they are tekketsu's in any terminal, with its palette at the foot: the greys from bone
// to iron, then a dagger and the bloods and the rest. Run `fastfetch -c tekketsu` once install.sh
// has put it in ~/.config/fastfetch/; the picture is drawn through kitty's graphics protocol.
// SPDX-License-Identifier: GPL-3.0-or-later
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/tekketsu/logo.png",
    "width": 18,
    "height": 9,
    "padding": {
      "top": 2,
      "left": 3,
      "right": 4
    }
  },
  "display": {
    "separator": "",
    "color": {
      "keys": "38;2;203;191;168",
      "title": "38;2;229;72;61",
      "output": "default"
    },
    "constants": [
      "                                  \u001b[38;2;70;61;61m│\u001b[35D\u001b[39m"
    ],
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "border": null,
      "color": {
        "elapsed": "38;2;229;72;61",
        "total": "38;2;70;61;61"
      },
      "width": 12
    },
    "percent": {
      "type": [
        "bar",
        "num"
      ],
      "color": {
        "green": "default",
        "yellow": "38;2;207;167;114",
        "red": "38;2;255;106;92"
      }
    },
    "duration": {
      "abbreviation": true
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;70;61;61}╭─ {#1;38;2;229;72;61}tekketsu{#0}{#38;2;70;61;61} ────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "{#38;2;70;61;61}│ {#38;2;229;72;61}{icon}  {#38;2;203;191;168}os       ",
      "format": "{$1}{pretty-name:-30}"
    },
    {
      "type": "kernel",
      "key": "{#38;2;70;61;61}│ {#38;2;229;72;61}{icon}  {#38;2;203;191;168}kernel   ",
      "format": "{$1}{release:-30}"
    },
    {
      "type": "wm",
      "key": "{#38;2;70;61;61}│ {#38;2;229;72;61}{icon}  {#38;2;203;191;168}wm       ",
      "format": "{$1}{pretty-name} {#38;2;142;130;125}{protocol-name}"
    },
    {
      "type": "shell",
      "key": "{#38;2;70;61;61}│ {#38;2;229;72;61}{icon}  {#38;2;203;191;168}shell    ",
      "format": "{$1}{pretty-name} {#38;2;142;130;125}{version}"
    },
    {
      "type": "terminal",
      "key": "{#38;2;70;61;61}│ {#38;2;229;72;61}{icon}  {#38;2;203;191;168}term     ",
      "format": "{$1}{pretty-name} {#38;2;142;130;125}{version}"
    },
    {
      "type": "terminalfont",
      "key": "{#38;2;70;61;61}│ {#38;2;229;72;61}{icon}  {#38;2;203;191;168}font     ",
      "format": "{$1}{name:-24} {#38;2;142;130;125}{size}pt"
    },
    {
      "type": "uptime",
      "key": "{#38;2;70;61;61}│ {#38;2;229;72;61}{icon}  {#38;2;203;191;168}uptime   ",
      "format": "{$1}{?days}{days}d {?}{hours}h {minutes}m"
    },
    {
      "type": "custom",
      "format": "{#38;2;70;61;61}├─ {#1;38;2;229;72;61}karakuri{#0}{#38;2;70;61;61} ────────────────────────────────────┤"
    },
    {
      "type": "cpu",
      "key": "{#38;2;70;61;61}│ {#38;2;229;72;61}{icon}  {#38;2;203;191;168}cpu      ",
      "format": "{$1}{name:-30}"
    },
    {
      "type": "gpu",
      "key": "{#38;2;70;61;61}│ {#38;2;229;72;61}{icon}  {#38;2;203;191;168}gpu      ",
      "format": "{$1}{name:-30}",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "{#38;2;70;61;61}│ {#38;2;229;72;61}{icon}  {#38;2;203;191;168}memory   ",
      "format": "{$1}{percentage-bar} {used}"
    },
    {
      "type": "disk",
      "key": "{#38;2;70;61;61}│ {#38;2;229;72;61}{icon}  {#38;2;203;191;168}disk     ",
      "format": "{$1}{size-percentage-bar} {size-used}",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "{#38;2;70;61;61}╰───────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "custom",
      "format": "   {#38;2;228;219;196}● {#38;2;203;191;168}● {#38;2;171;159;144}● {#38;2;142;130;125}● {#38;2;107;96;94}● {#38;2;70;61;61}●  {#38;2;230;222;177}† {#38;2;196;43;35}● {#38;2;110;23;18}● {#38;2;229;72;61}● {#38;2;255;106;92}● {#38;2;207;167;114}● {#38;2;230;222;177}● {#38;2;167;185;140}● {#38;2;161;150;173}● {#38;2;156;178;201}● {#38;2;140;111;143}●"
    }
  ]
}

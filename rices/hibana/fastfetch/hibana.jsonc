// hibana (火花) for fastfetch: the little devil cat beside a spec sheet in a box, the hardware
// under `nokogiri`, the saw. Ember titles and icons, ash keys and a smoke-grey frame, set in
// 24-bit colour so they are hibana's in any terminal, with its palette at the foot: the greys from
// paper to ash, then the embers and the rest. Run `fastfetch -c hibana` once install.sh has put it
// in ~/.config/fastfetch/; the picture is drawn through kitty's graphics protocol.
// SPDX-License-Identifier: GPL-3.0-or-later
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/hibana/logo.png",
    "width": 18,
    "height": 9,
    "padding": {
      "top": 2,
      "left": 3,
      "right": 4
    }
  },
  "display": {
    "separator": "",
    "color": {
      "keys": "38;2;198;193;198",
      "title": "38;2;255;122;51",
      "output": "default"
    },
    "constants": [
      "                                  \u001b[38;2;75;70;80m│\u001b[35D\u001b[39m"
    ],
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "border": null,
      "color": {
        "elapsed": "38;2;255;122;51",
        "total": "38;2;75;70;80"
      },
      "width": 12
    },
    "percent": {
      "type": [
        "bar",
        "num"
      ],
      "color": {
        "green": "default",
        "yellow": "38;2;220;179;110",
        "red": "38;2;229;89;77"
      }
    },
    "duration": {
      "abbreviation": true
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;75;70;80}╭─ {#1;38;2;255;122;51}hibana{#0}{#38;2;75;70;80} ──────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "{#38;2;75;70;80}│ {#38;2;255;122;51}{icon}  {#38;2;198;193;198}os       ",
      "format": "{$1}{pretty-name:-30}"
    },
    {
      "type": "kernel",
      "key": "{#38;2;75;70;80}│ {#38;2;255;122;51}{icon}  {#38;2;198;193;198}kernel   ",
      "format": "{$1}{release:-30}"
    },
    {
      "type": "wm",
      "key": "{#38;2;75;70;80}│ {#38;2;255;122;51}{icon}  {#38;2;198;193;198}wm       ",
      "format": "{$1}{pretty-name} {#38;2;143;138;148}{protocol-name}"
    },
    {
      "type": "shell",
      "key": "{#38;2;75;70;80}│ {#38;2;255;122;51}{icon}  {#38;2;198;193;198}shell    ",
      "format": "{$1}{pretty-name} {#38;2;143;138;148}{version}"
    },
    {
      "type": "terminal",
      "key": "{#38;2;75;70;80}│ {#38;2;255;122;51}{icon}  {#38;2;198;193;198}term     ",
      "format": "{$1}{pretty-name} {#38;2;143;138;148}{version}"
    },
    {
      "type": "terminalfont",
      "key": "{#38;2;75;70;80}│ {#38;2;255;122;51}{icon}  {#38;2;198;193;198}font     ",
      "format": "{$1}{name:-24} {#38;2;143;138;148}{size}pt"
    },
    {
      "type": "uptime",
      "key": "{#38;2;75;70;80}│ {#38;2;255;122;51}{icon}  {#38;2;198;193;198}uptime   ",
      "format": "{$1}{?days}{days}d {?}{hours}h {minutes}m"
    },
    {
      "type": "custom",
      "format": "{#38;2;75;70;80}├─ {#1;38;2;255;122;51}nokogiri{#0}{#38;2;75;70;80} ────────────────────────────────────┤"
    },
    {
      "type": "cpu",
      "key": "{#38;2;75;70;80}│ {#38;2;255;122;51}{icon}  {#38;2;198;193;198}cpu      ",
      "format": "{$1}{name:-30}"
    },
    {
      "type": "gpu",
      "key": "{#38;2;75;70;80}│ {#38;2;255;122;51}{icon}  {#38;2;198;193;198}gpu      ",
      "format": "{$1}{name:-30}",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "{#38;2;75;70;80}│ {#38;2;255;122;51}{icon}  {#38;2;198;193;198}memory   ",
      "format": "{$1}{percentage-bar} {used}"
    },
    {
      "type": "disk",
      "key": "{#38;2;75;70;80}│ {#38;2;255;122;51}{icon}  {#38;2;198;193;198}disk     ",
      "format": "{$1}{size-percentage-bar} {size-used}",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "{#38;2;75;70;80}╰───────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "custom",
      "format": "   {#38;2;226;221;217}● {#38;2;198;193;198}● {#38;2;168;163;171}● {#38;2;143;138;148}● {#38;2;110;106;114}● {#38;2;75;70;80}●  {#38;2;255;176;112}✦ {#38;2;255;122;51}● {#38;2;255;176;112}● {#38;2;200;68;60}● {#38;2;229;89;77}● {#38;2;220;179;110}● {#38;2;163;181;143}● {#38;2;143;176;180}● {#38;2;159;179;204}● {#38;2;179;154;174}●"
    }
  ]
}
